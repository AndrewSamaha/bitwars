PLAYER_AUTH_SECRET=thisisnosecret
GAMESTATE_REDIS_URL=redis://localhost:6379
RTS_ENGINE_LOG_LEVEL=info
GAME_ID=testgameid
AXIOM_TOKEN=
AXIOM_DATASET=bitwars
RESTORE_GAMESTATE_ON_RESTART=false
CONTENT_PACK_PATH=/Users/andrew/Development/bitwars/packages/content/entities.yaml
SPAWN_CONFIG_PATH=/Users/andrew/Development/bitwars/services/rts-engine/config/spawn.yaml

# Set to 1 to enable Pixi shader effects (currently the animated star shader).
NEXT_PUBLIC_ENABLE_SHADERS=0

# Web client debug: set to 1 to show move-input debug badge and console logs.
NEXT_PUBLIC_DEBUG_MOVE_INPUT=0
# Set to 1 to show a lightweight Pixi render FPS badge.
NEXT_PUBLIC_DEBUG_SHOW_FPS=0
# Set to 1 to log every snapshot/delta with the complete entity list.
NEXT_PUBLIC_DEBUG_LOG_GAMESTATE_ENTITIES=0
