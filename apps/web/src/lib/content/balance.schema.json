{
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "id", "visualization_type", "x", "y"],
      "properties": {
        "version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S+$"
        },
        "name": {
          "type": "string"
        },
        "visualization_type": {
          "const": "scatter_plot"
        },
        "x": {
          "type": "object",
          "additionalProperties": false,
          "required": ["expression"],
          "properties": {
            "expression": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string"
            },
            "min": {
              "type": "number",
              "description": "Lower bound of the main axis. Smaller values share one position beyond a break."
            },
            "max": {
              "type": "number",
              "description": "Upper bound of the main axis. Larger values share one position beyond a break."
            }
          }
        },
        "y": {
          "type": "object",
          "additionalProperties": false,
          "required": ["expression"],
          "properties": {
            "expression": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string"
            },
            "min": {
              "type": "number",
              "description": "Lower bound of the main axis. Smaller values share one position beyond a break."
            },
            "max": {
              "type": "number",
              "description": "Upper bound of the main axis. Larger values share one position beyond a break."
            }
          }
        },
        "dot_size": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 40,
          "description": "Scatter sprite size in pixels. Smaller values reduce overlap without changing coordinates."
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "id", "visualization_type", "value"],
      "properties": {
        "version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S+$"
        },
        "name": {
          "type": "string"
        },
        "visualization_type": {
          "const": "bar_chart"
        },
        "value": {
          "type": "object",
          "additionalProperties": false,
          "required": ["expression"],
          "properties": {
            "expression": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string"
            },
            "min": {
              "type": "number",
              "description": "Lower bound of the main axis. Smaller values share one position beyond a break."
            },
            "max": {
              "type": "number",
              "description": "Upper bound of the main axis. Larger values share one position beyond a break."
            }
          }
        },
        "order": {
          "enum": ["descending", "ascending"],
          "default": "descending"
        }
      }
    }
  ]
}
